# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa secret: chỉ dùng phía server, tuyệt đối không đặt tiền tố NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (chatbot trang chủ). Điền key vào .env.local, không commit.
GEMINI_API_KEY=
# Tuỳ chọn, mặc định gemini-3.5-flash-lite
GEMINI_MODEL=

# Đăng nhập khu vực /admin (Basic Auth). Bắt buộc, nếu thiếu /admin bị khóa.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Tuỳ chọn, model trích xuất lead (mặc định gemini-3.1-flash-lite)
GEMINI_LEAD_MODEL=

# Webhook Make.com nhận yêu cầu báo giá mới (xem như khóa bí mật, đặt cả trên Vercel, không commit).
MAKE_WEBHOOK_URL=

# Webhook Make.com nhận thông báo khi admin duyệt yêu cầu (xem như khóa bí mật, đặt cả trên Vercel, không commit).
MAKE_APPROVAL_WEBHOOK_URL=
# Link đăng nhập gửi cho khách khi duyệt. Để trống thì dùng <địa chỉ website>/login. Tuần sau có trang đăng nhập thật chỉ cần đổi giá trị này.
APPROVAL_LOGIN_LINK=
